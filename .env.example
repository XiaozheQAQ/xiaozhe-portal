# Copy to .env (local) and/or set the same names in the Vercel dashboard.
# Never commit real values.

# ── Article views (likes come from giscus reactions) ──────────────────
# Server-side only. These must NOT be prefixed with PUBLIC_ and must never be
# imported into browser code.
# Upstash console -> your database -> "REST API" section.
# Leave them empty and a deployment simply renders no view counter (no
# placeholder, no error line). `npm run dev` falls back to a process-local
# counter and labels it as such. See docs/engagement-setup.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Article comments: giscus + GitHub Discussions ────────────────────
# Public identifiers, safe to ship to the browser. They are not secrets.
# Optional: src/lib/config/comments.ts already carries the working defaults for
# this repository, so the comment box renders without any of these. Set them to
# point giscus at a different repository or category.
# See docs/engagement-setup.md.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
